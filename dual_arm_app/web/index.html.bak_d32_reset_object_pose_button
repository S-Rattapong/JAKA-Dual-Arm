async function runSequence() {
  sequence = sequence.map(normalizeProgramStep);

  if (sequence.length === 0) {
    alert("ยังไม่มี waypoint ใน program");
    return;
  }

  const summary = sequence.map((s, i) => {
    return `${i + 1}. ${s.name} [${s.side}] v=${s.vel} a=${s.acc} delay=${s.delay}s`;
  }).join("\n");

  const ok = confirm(
    "Run program?\n\n" +
    summary + "\n\n" +
    "ตรวจสอบพื้นที่หุ่น และเตรียม E-stop ก่อนกด OK"
  );

  if (!ok) return;

  const data = await api("/api/program/run", {
