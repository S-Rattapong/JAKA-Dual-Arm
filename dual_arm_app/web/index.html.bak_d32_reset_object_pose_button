async function loadWaypoints(showLoading=false) {
  if (waypointLoading) return;
  waypointLoading = true;

  const box = $("waypointList");
  if (showLoading) box.textContent = "Loading...";

  try {
    const data = await api("/api/waypoints");
    const names = Object.keys(data || {}).sort();

    if (names.length === 0) {
      box.innerHTML = "<div class='small'>ยังไม่มี waypoint</div>";
      waypointLoading = false;
      return;
    }

    box.innerHTML = "";

    names.forEach(name => {
      const wp = data[name] || {};
      const row = document.createElement("div");
      row.className = "wp-row";

      const title = document.createElement("div");
      title.innerHTML =
        `<span class="wp-name">${name}</span>` +
        `<span class="wp-time">${wp.created_at || ""}</span>`;

      const actions = document.createElement("div");
      actions.className = "wp-actions";

      const runBtn = document.createElement("button");
      runBtn.className = "orange";
      runBtn.textContent = "Run";
      runBtn.onclick = () => runWaypoint(name);

      const addBtn = document.createElement("button");
      addBtn.textContent = "Add";
      addBtn.onclick = () => addToSequence(name);

      const delBtn = document.createElement("button");
      delBtn.className = "stop";
      delBtn.textContent = "Delete";
      delBtn.onclick = () => deleteWaypoint(name);

      actions.appendChild(runBtn);
      actions.appendChild(addBtn);
      actions.appendChild(delBtn);

      row.appendChild(title);
      row.appendChild(actions);
      box.appendChild(row);
    });
  } catch (e) {
    box.textContent = "Waypoint load error: " + e.message;
  } finally {
    waypointLoading = false;
  }
}

function normalizeProgramStep(step) {
  if (typeof step === "string") {
    return {
      name: step,
      side: "both",
      vel: parseFloat($("moveVel").value),
      acc: parseFloat($("moveAcc").value),
      delay: 0
    };
  }

  return {
    name: step.name,
    side: step.side || "both",
    vel: Number.isFinite(parseFloat(step.vel)) ? parseFloat(step.vel) : parseFloat($("moveVel").value),
    acc: Number.isFinite(parseFloat(step.acc)) ? parseFloat(step.acc) : parseFloat($("moveAcc").value),
    delay: Number.isFinite(parseFloat(step.delay)) ? parseFloat(step.delay) : 0
  };
}

function addToSequence(name) {
  sequence.push({
    name: name,
    side: "both",
    vel: parseFloat($("moveVel").value),
    acc: parseFloat($("moveAcc").value),
    delay: 0
  });
  renderSequence();
}

function updateSequenceStep(i, key, value) {
  sequence = sequence.map(normalizeProgramStep);

  if (!sequence[i]) return;

  if (key === "name" || key === "side") {
    sequence[i][key] = value;
  } else {
    const v = parseFloat(value);
    sequence[i][key] = Number.isFinite(v) ? v : 0;
    if (key === "delay" && sequence[i][key] < 0) sequence[i][key] = 0;
  }
}

function removeSequenceIndex(i) {
  sequence.splice(i, 1);
  renderSequence();
}

function clearSequence() {
  sequence = [];
  renderSequence();
}

function renderSequence() {
  const box = $("sequenceList");
  sequence = sequence.map(normalizeProgramStep);

  if (sequence.length === 0) {
    box.innerHTML = "<div class='small'>ยังไม่มี step ใน program</div>";
    return;
  }

  let html = `
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Waypoint</th>
          <th>Side</th>
          <th>Vel</th>
          <th>Acc</th>
          <th>Delay after</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
  `;

  sequence.forEach((step, i) => {
    html += `
      <tr>
        <td>${i + 1}</td>
        <td><b>${step.name}</b></td>
        <td>
          <select onchange="updateSequenceStep(${i}, 'side', this.value)">
            <option value="both" ${step.side === "both" ? "selected" : ""}>both</option>
            <option value="left" ${step.side === "left" ? "selected" : ""}>left</option>
            <option value="right" ${step.side === "right" ? "selected" : ""}>right</option>
          </select>
        </td>
        <td>
          <input class="num" type="number" step="0.1" min="0.02" max="3.0"
            value="${step.vel}"
            onchange="updateSequenceStep(${i}, 'vel', this.value)" />
        </td>
        <td>
          <input class="num" type="number" step="0.1" min="0.04" max="3.0"
            value="${step.acc}"
            onchange="updateSequenceStep(${i}, 'acc', this.value)" />
        </td>
        <td>
          <input class="num" type="number" step="0.1" min="0" max="30"
            value="${step.delay}"
            onchange="updateSequenceStep(${i}, 'delay', this.value)" />
          <span class="small">s</span>
        </td>
        <td>
          <button class="stop" onclick="removeSequenceIndex(${i})">Remove</button>
        </td>
      </tr>
    `;
  });

  html += "</tbody></table>";
  box.innerHTML = html;
}

