    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({
      side: "both",
      vel: parseFloat($("moveVel").value),
      acc: parseFloat($("moveAcc").value),
      steps: sequence
    })
  });

  setStatus(data);
}


