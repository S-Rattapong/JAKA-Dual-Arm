<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dual JAKA A12 Control</title>

  <style>
    :root {
      --bg: #111827;
      --panel: #1f2937;
      --panel2: #0f172a;
      --line: #374151;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --blue: #2563eb;
      --green: #059669;
      --orange: #d97706;
      --red: #dc2626;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 16px;
    }

    h1, h2, h3 {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 14px;
      font-size: 26px;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 12px;
    }

    h3 {
      font-size: 16px;
      margin: 12px 0 8px;
      color: #f9fafb;
    }

    .panel {
      background: var(--panel);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 14px;
      border: 1px solid rgba(255,255,255,0.03);
    }

    .top-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 14px;
      align-items: start;
    }

    .two-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      align-items: start;
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 8px 0;
      align-items: center;
    }

    .small {
      font-size: 13px;
      color: var(--muted);
    }

    button {
      border: none;
      border-radius: 8px;
      padding: 10px 14px;
      background: #374151;
      color: white;
      font-size: 15px;
      cursor: pointer;
      min-width: 74px;
      user-select: none;
      touch-action: none;
    }

    button:hover {
      background: #4b5563;
    }

    button.active {
      background: var(--blue);
    }

    button.green {
      background: var(--green);
    }

    button.green:hover {
      background: #047857;
    }

    button.orange {
      background: var(--orange);
    }

    button.orange:hover {
      background: #b45309;
    }

    button.stop {
      background: var(--red);
      font-weight: bold;
      min-width: 140px;
    }

    button.stop:hover {
      background: #b91c1c;
    }

    select, input {
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #4b5563;
      background: var(--bg);
      color: white;
    }

    input.num {
      width: 78px;
      text-align: right;
    }

    input.wide {
      min-width: 280px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th, td {
      border: 1px solid #334155;
      padding: 5px 6px;
      text-align: center;
    }

    th {
      background: #111827;
      color: #cbd5e1;
    }

    td {
      background: #0b1120;
    }

    .jog-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .jog-section {
      background: var(--panel2);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
    }

    .jog-row {
      display: grid;
      grid-template-columns: 54px 1fr 1fr;
      gap: 6px;
      align-items: center;
      margin: 6px 0;
    }

    .jog-label {
      color: var(--muted);
      font-weight: bold;
      text-align: center;
    }

    .direct-inputs {
      display: grid;
      grid-template-columns: repeat(6, minmax(72px, 1fr));
      gap: 6px;
    }

    .direct-inputs label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }

    .wp-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-top: 10px;
    }

    .wp-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 8px 10px;
      border: 1px solid #41485f;
      border-radius: 8px;
      background: var(--panel2);
    }

    .wp-name {
      font-weight: 700;
    }

    .wp-time {
      font-size: 12px;
      color: var(--muted);
      margin-left: 6px;
      font-weight: 400;
    }

    .wp-actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .sequence-box {
      background: var(--panel2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      min-height: 52px;
    }

    .seq-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid #263244;
    }

    .seq-row:last-child {
      border-bottom: none;
    }

    pre {
      background: #0b1120;
      padding: 12px;
      border-radius: 8px;
      overflow: auto;
      max-height: 260px;
      border: 1px solid var(--line);
    }

    @media (max-width: 1200px) {
      .top-grid,
      .two-grid,
      .jog-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .direct-inputs {
        grid-template-columns: repeat(2, 1fr);
      }

      .wp-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <h1>Dual JAKA A12 Control</h1>

  <div class="top-grid">
    <div class="panel">
      <h2>Live Position / Direct Move</h2>

      <div class="two-grid">
        <div>
          <h3>Left Robot</h3>
          <table>
            <tr><th>J1°</th><th>J2°</th><th>J3°</th><th>J4°</th><th>J5°</th><th>J6°</th></tr>
            <tr id="leftJointRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
            <tr><th>X</th><th>Y</th><th>Z</th><th>Rx</th><th>Ry</th><th>Rz</th></tr>
            <tr id="leftTcpRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
          </table>
        </div>

        <div>
          <h3>Right Robot</h3>
          <table>
            <tr><th>J1°</th><th>J2°</th><th>J3°</th><th>J4°</th><th>J5°</th><th>J6°</th></tr>
            <tr id="rightJointRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
            <tr><th>X</th><th>Y</th><th>Z</th><th>Rx</th><th>Ry</th><th>Rz</th></tr>
            <tr id="rightTcpRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
          </table>
        </div>
      </div>

      <h3>Direct Joint Move</h3>
      <div class="small">กรอกค่า Joint เป็นองศา แล้วกด Confirm เพื่อสั่งหุ่นเคลื่อนที่</div>

      <div class="row">
        <label>Target side:
          <select id="directSide">
            <option value="both">Both</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
          </select>
        </label>

        <button onclick="fillJointInputsFromCurrent()">Fill Current</button>
        <button class="orange" onclick="sendDirectJointMove()">Confirm Joint Move</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>

      <div class="two-grid">
        <div>
          <h3>Left Target (deg)</h3>
          <div class="direct-inputs" id="leftJointInputs"></div>
        </div>
        <div>
          <h3>Right Target (deg)</h3>
          <div class="direct-inputs" id="rightJointInputs"></div>
        </div>
      </div>


      <h3>Direct TCP Move</h3>
      <div class="small">
        Safe TCP Move ใช้หลักการ TCP → IK → Joint Move ดังนั้นความเร็วจะอิงจาก Move vel / Move acc ด้านบน ไม่ใช้ linear_move โดยตรง
      </div>

      <div class="row">
        <label>Target side:
          <select id="directTcpSide">
            <option value="both">Both</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
          </select>
        </label>
    <button onclick="fillTcpInputsFromCurrent()">Fill Current TCP</button>
        <button class="orange" onclick="sendDirectTcpMove()">Confirm Safe TCP Move</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>

      <div class="two-grid">
        <div>
          <h3>Left TCP Target</h3>
          <div class="direct-inputs" id="leftTcpInputs"></div>
        </div>
        <div>
          <h3>Right TCP Target</h3>
          <div class="direct-inputs" id="rightTcpInputs"></div>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2>Dual JAKA A12 Manual Jog</h2>

      <div class="row">
        <strong>Robot:</strong>
        <button id="side-left" onclick="setSide('left')">Left</button>
        <button id="side-right" onclick="setSide('right')">Right</button>
        <button id="side-both" onclick="setSide('both')">Both</button>
      </div>

      <div class="row">
        <strong>Mode:</strong>
        <button id="coord-joint" onclick="setCoord('joint')">Joint</button>
        <button id="coord-base" onclick="setCoord('base')">Base TCP</button>
        <button id="coord-tool" onclick="setCoord('tool')">Tool TCP</button>
      </div>

      <div class="row">
        <strong>Both Sync:</strong>
        <select id="syncMode">
          <option value="same">Same</option>
          <option value="mirror">Mirror</option>
          <option value="raw">Raw</option>
        </select>
      </div>

      <div class="row">
        <label>Linear:</label>
        <input id="linearSpeed" type="number" value="5" step="1" min="1" max="50" class="num" />
        <label>Rotate:</label>
        <input id="rotateSpeed" type="number" value="2" step="0.5" min="0.5" max="20" class="num" />
        <label>Joint:</label>
        <input id="jointSpeed" type="number" value="0.03" step="0.01" min="0.005" max="0.2" class="num" />
      </div>

      <div class="row">
        <label>Move vel:</label>
        <input id="moveVel" type="number" value="2.0" step="0.1" min="0.02" max="3.0" class="num" />
        <label>Move acc:</label>
        <input id="moveAcc" type="number" value="1.2" step="0.1" min="0.04" max="3.0" class="num" />
      </div>

      <div class="row">
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
        <button class="green" onclick="homeBoth()">Home Both</button>
        <button onclick="refreshStatus()">Refresh Status</button>
      </div>

      <div class="jog-grid">
        <div class="jog-section">
          <h3>Joint Jog</h3>
          <div id="jointButtons"></div>
        </div>

        <div class="jog-section">
          <h3>TCP Jog 6 Axis</h3>
          <div id="tcpButtons"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Waypoint Manager</h2>

    <div class="row">
      <input id="waypointName" class="wide" placeholder="waypoint name เช่น p1_pre_grasp" />
      <button class="green" onclick="saveWaypoint()">Save Current</button>
      <button onclick="loadWaypoints(true)">Reload List</button>
    </div>

    <div id="waypointList" class="wp-list">Loading...</div>
  </div>

  <div class="two-grid">
    <div class="panel">
      <h2>Program / Sequence</h2>
      <div class="small">กด Add จาก Waypoint Manager เพื่อเรียงลำดับงาน</div>

      <div class="row" style="margin-top: 10px;">
        <label>Program name:</label>
        <input id="programName" type="text" value="demo_pick_place" style="min-width: 180px;" />
        <button onclick="saveProgramFile()">Save File</button>
        <button onclick="refreshProgramList()">Refresh List</button>
        <select id="programSelect" style="min-width: 180px;"></select>
        <button onclick="loadSelectedProgram()">Load File</button>
        <button class="stop" onclick="deleteSelectedProgram()">Delete File</button>
      </div>

      <div id="sequenceList" class="sequence-box"></div>

      <div class="row">
        <button class="green" onclick="runSequence()">Run Program</button>
        <button onclick="saveProgramFile()">Save Program</button>
        <button onclick="loadSelectedProgram()">Load Program</button>
        <button onclick="clearSequence()">Clear Sequence</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>
    </div>

    <div class="panel">
      
    <div class="card">
      <h2>D32 Object Frame / Cooperative Setup</h2>
      <div class="small">
        ขั้นนี้ยังไม่สั่งหุ่นเคลื่อนที่ ใช้สำหรับบันทึก object frame และ grasp offset ของ TCP ซ้าย/ขวา
      </div>

      <div class="row" style="margin-top: 10px;">
        <label>Object name:</label>
        <input id="objectName" type="text" value="demo_object" style="min-width: 180px;" />
        <button onclick="fillObjectPoseFromMidpoint()">Fill Object From TCP Midpoint</button>
        <button onclick="captureObjectFrameCurrent()">Capture & Save Object Frame</button>
        <button class="orange" onclick="previewObjectTargets()">Preview Cooperative Targets</button>
        <button onclick="refreshObjectList()">Refresh Objects</button>
      </div>

      <h3>Object Pose Target / Capture Reference</h3>
      <div id="objectPoseInputs" class="targets"></div>

      <div class="row" style="margin-top: 10px;">
        <select id="objectSelect" style="min-width: 220px;"></select>
        <button onclick="loadSelectedObjectFrame()">Load Object</button>
        <button class="stop" onclick="deleteSelectedObjectFrame()">Delete Object</button>
      </div>

      <pre id="objectFrameView" class="statusbox">Object frame not loaded yet.</pre>
    </div>

<h2>Status</h2>
      <pre id="status">loading...</pre>
    </div>
  </div>

<script>
let side = "both";
let coord = "base";
let heartbeatTimer = null;
let sequence = [];
let lastStatus = null;
let waypointLoading = false;

function $(id) {
  return document.getElementById(id);
}

function fmt(v) {
  const n = Number(v);
  if (!Number.isFinite(n)) return "-";
  return n.toFixed(3);
}

function radToDeg(v) {
  return Number(v) * 180.0 / Math.PI;
}

function setStatus(data) {
  const el = $("status");
  if (el) el.textContent = JSON.stringify(data, null, 2);
}

async function api(path, options = {}) {
  const res = await fetch(path, options);
  const data = await res.json();
  return data;
}

function setSide(v) {
  side = v;
  ["left", "right", "both"].forEach(s => {
    $("side-" + s).classList.toggle("active", s === v);
  });
}

function setCoord(v) {
  coord = v;
  ["joint", "base", "tool"].forEach(c => {
    $("coord-" + c).classList.toggle("active", c === v);
  });
  buildButtons();
}

function speedFor(axis, jogCoord) {
  axis = axis.toLowerCase();
  if (jogCoord === "joint") return parseFloat($("jointSpeed").value);
  if (["rx", "ry", "rz"].includes(axis)) return parseFloat($("rotateSpeed").value);
  return parseFloat($("linearSpeed").value);
}

async function startJog(jogCoord, axis, direction) {
  const payload = {
    side,
    coord: jogCoord,
    axis,
    direction,
    speed: speedFor(axis, jogCoord),
    sync_mode: $("syncMode").value
  };

  const data = await api("/api/jog/start", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(payload)
  });

  setStatus(data);

  if (heartbeatTimer) clearInterval(heartbeatTimer);
  heartbeatTimer = setInterval(() => {
    fetch("/api/jog/heartbeat", {method: "POST"});
  }, 80);
}

async function stopJog() {
  if (heartbeatTimer) {
    clearInterval(heartbeatTimer);
    heartbeatTimer = null;
  }

  await fetch("/api/jog/stop", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({side})
  });

  refreshStatus();
}

async function stopBoth() {
  if (heartbeatTimer) {
    clearInterval(heartbeatTimer);
    heartbeatTimer = null;
  }

  const data = await api("/api/stop", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({side: "both"})
  });

  setStatus(data);
  refreshPoseMonitor();
}

async function homeBoth() {
  const ok = confirm("Home Both จะสั่งแขนทั้งสองกลับตำแหน่ง Home ที่ตั้งไว้ ต้องแน่ใจว่าพื้นที่ปลอดภัยแล้ว");
  if (!ok) return;

  const data = await api("/api/home", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({
      side: "both",
      vel: parseFloat($("moveVel").value),
      acc: parseFloat($("moveAcc").value)
    })
  });

  setStatus(data);
}

function makeHoldButton(label, jogCoord, axis, direction) {
  const b = document.createElement("button");
  b.textContent = label;

  let holding = false;
  let capturedPointerId = null;

  const start = (e) => {
    e.preventDefault();

    if (holding) return;
    holding = true;
    capturedPointerId = e.pointerId;

    b.classList.add("active");

    if (b.setPointerCapture && e.pointerId !== undefined) {
      try {
        b.setPointerCapture(e.pointerId);
      } catch (_) {}
    }

    startJog(jogCoord, axis, direction);
  };

  const stop = (e) => {
    if (e) e.preventDefault();

    if (!holding) return;
    holding = false;

    b.classList.remove("active");

    if (b.releasePointerCapture && capturedPointerId !== null) {
      try {
        b.releasePointerCapture(capturedPointerId);
      } catch (_) {}
    }

    capturedPointerId = null;
    stopJog();
  };

  b.addEventListener("pointerdown", start);
  b.addEventListener("pointerup", stop);
  b.addEventListener("pointercancel", stop);
  b.addEventListener("lostpointercapture", stop);

  // กัน browser เปิด context menu ตอนกดค้าง
  b.addEventListener("contextmenu", (e) => e.preventDefault());

  return b;
}


function buildButtons() {
  const jointDiv = $("jointButtons");
  jointDiv.innerHTML = "";

  ["j1", "j2", "j3", "j4", "j5", "j6"].forEach(j => {
    const row = document.createElement("div");
    row.className = "jog-row";

    const label = document.createElement("div");
    label.className = "jog-label";
    label.textContent = j.toUpperCase();

    row.appendChild(label);
    row.appendChild(makeHoldButton("-", "joint", j, "-"));
    row.appendChild(makeHoldButton("+", "joint", j, "+"));
    jointDiv.appendChild(row);
  });

  const tcpDiv = $("tcpButtons");
  tcpDiv.innerHTML = "";

  ["x", "y", "z", "rx", "ry", "rz"].forEach(a => {
    const row = document.createElement("div");
    row.className = "jog-row";

    const label = document.createElement("div");
    label.className = "jog-label";
    label.textContent = a.toUpperCase();

    row.appendChild(label);
    row.appendChild(makeHoldButton("-", coord === "joint" ? "base" : coord, a, "-"));
    row.appendChild(makeHoldButton("+", coord === "joint" ? "base" : coord, a, "+"));
    tcpDiv.appendChild(row);
  });
}

function findDeepArray(obj, sideName, words) {
  if (!obj || typeof obj !== "object") return null;

  for (const [k, v] of Object.entries(obj)) {
    const key = String(k).toLowerCase();

    if (
      Array.isArray(v) &&
      v.length >= 6 &&
      key.includes(sideName) &&
      words.some(w => key.includes(w))
    ) {
      return v;
    }

    if (v && typeof v === "object") {
      const found = findDeepArray(v, sideName, words);
      if (found) return found;
    }
  }

  return null;
}

function findArrayByCandidates(obj, candidates) {
  if (!obj) return null;

  for (const key of candidates) {
    if (Array.isArray(obj[key]) && obj[key].length >= 6) return obj[key];
  }

  for (const key of candidates) {
    const parts = key.split(".");
    let cur = obj;
    let ok = true;

    for (const p of parts) {
      if (cur && Object.prototype.hasOwnProperty.call(cur, p)) {
        cur = cur[p];
      } else {
        ok = false;
        break;
      }
    }

    if (ok && Array.isArray(cur) && cur.length >= 6) return cur;
  }

  return null;
}

function extractStatusArrays(data) {
  const leftJoint = findArrayByCandidates(data, [
    "left_joint", "left_joints", "left_joint_position", "left_joint_positions",
    "left.joint", "left.joints", "left.joint_position", "left.joint_positions"
  ]) || findDeepArray(data, "left", ["joint"]);

  const rightJoint = findArrayByCandidates(data, [
    "right_joint", "right_joints", "right_joint_position", "right_joint_positions",
    "right.joint", "right.joints", "right.joint_position", "right.joint_positions"
  ]) || findDeepArray(data, "right", ["joint"]);

  const leftTcp = findArrayByCandidates(data, [
    "left_tcp", "left_pose", "left_tcp_pose", "left_cartesian", "left_cart",
    "left.tcp", "left.pose", "left.tcp_pose", "left.cartesian", "left.cart"
  ]) || findDeepArray(data, "left", ["tcp", "pose", "cart"]);

  const rightTcp = findArrayByCandidates(data, [
    "right_tcp", "right_pose", "right_tcp_pose", "right_cartesian", "right_cart",
    "right.tcp", "right.pose", "right.tcp_pose", "right.cartesian", "right.cart"
  ]) || findDeepArray(data, "right", ["tcp", "pose", "cart"]);

  return {leftJoint, rightJoint, leftTcp, rightTcp};
}

function setTableRow(rowId, values, convertDeg=false) {
  const row = $(rowId);
  if (!row) return;

  const vals = Array.isArray(values) ? values.slice(0, 6) : [];
  row.innerHTML = "";

  for (let i = 0; i < 6; i++) {
    const td = document.createElement("td");
    const raw = vals[i];
    td.textContent = raw === undefined ? "-" : fmt(convertDeg ? radToDeg(raw) : raw);
    row.appendChild(td);
  }
}

async function refreshPoseMonitor() {
  try {
    const data = await api("/api/status");
    lastStatus = data;

    const a = extractStatusArrays(data);
    setTableRow("leftJointRow", a.leftJoint, true);
    setTableRow("rightJointRow", a.rightJoint, true);
    setTableRow("leftTcpRow", a.leftTcp, false);
    setTableRow("rightTcpRow", a.rightTcp, false);
  } catch (e) {
    console.warn("pose monitor error:", e);
  }
}

async function refreshStatus() {
  const data = await api("/api/status");
  setStatus(data);
  lastStatus = data;

  const a = extractStatusArrays(data);
  setTableRow("leftJointRow", a.leftJoint, true);
  setTableRow("rightJointRow", a.rightJoint, true);
