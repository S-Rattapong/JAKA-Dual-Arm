function makeHoldButton(label, jogCoord, axis, direction) {
  const b = document.createElement("button");
  b.textContent = label;

  let holding = false;
  let capturedPointerId = null;

  const start = (e) => {
    e.preventDefault();

    if (holding) return;
    holding = true;
    capturedPointerId = e.pointerId;

    b.classList.add("active");

    if (b.setPointerCapture && e.pointerId !== undefined) {
      try {
        b.setPointerCapture(e.pointerId);
      } catch (_) {}
    }

    startJog(jogCoord, axis, direction);
  };

  const stop = (e) => {
    if (e) e.preventDefault();

    if (!holding) return;
    holding = false;

    b.classList.remove("active");

    if (b.releasePointerCapture && capturedPointerId !== null) {
      try {
        b.releasePointerCapture(capturedPointerId);
      } catch (_) {}
    }

    capturedPointerId = null;
    stopJog();
  };

  b.addEventListener("pointerdown", start);
  b.addEventListener("pointerup", stop);
  b.addEventListener("pointercancel", stop);
  b.addEventListener("lostpointercapture", stop);

  // กัน browser เปิด context menu ตอนกดค้าง
  b.addEventListener("contextmenu", (e) => e.preventDefault());

  return b;
}


