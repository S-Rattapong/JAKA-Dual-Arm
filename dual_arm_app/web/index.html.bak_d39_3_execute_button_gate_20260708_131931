<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dual JAKA A12 Control</title>

  <style>
    :root {
      --bg: #111827;
      --panel: #1f2937;
      --panel2: #0f172a;
      --line: #374151;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --blue: #2563eb;
      --green: #059669;
      --orange: #d97706;
      --red: #dc2626;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 16px;
    }

    h1, h2, h3 {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 14px;
      font-size: 26px;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 12px;
    }

    h3 {
      font-size: 16px;
      margin: 12px 0 8px;
      color: #f9fafb;
    }

    .panel {
      background: var(--panel);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 14px;
      border: 1px solid rgba(255,255,255,0.03);
    }

    .top-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 14px;
      align-items: start;
    }

    .two-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      align-items: start;
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 8px 0;
      align-items: center;
    }

    .small {
      font-size: 13px;
      color: var(--muted);
    }

    button {
      border: none;
      border-radius: 8px;
      padding: 10px 14px;
      background: #374151;
      color: white;
      font-size: 15px;
      cursor: pointer;
      min-width: 74px;
      user-select: none;
      touch-action: none;
    }

    button:hover {
      background: #4b5563;
    }

    button.active {
      background: var(--blue);
    }

    button.green {
      background: var(--green);
    }

    button.green:hover {
      background: #047857;
    }

    button.orange {
      background: var(--orange);
    }

    button.orange:hover {
      background: #b45309;
    }

    button.stop {
      background: var(--red);
      font-weight: bold;
      min-width: 140px;
    }

    button.stop:hover {
      background: #b91c1c;
    }

    select, input {
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #4b5563;
      background: var(--bg);
      color: white;
    }

    input.num {
      width: 78px;
      text-align: right;
    }

    input.wide {
      min-width: 280px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th, td {
      border: 1px solid #334155;
      padding: 5px 6px;
      text-align: center;
    }

    th {
      background: #111827;
      color: #cbd5e1;
    }

    td {
      background: #0b1120;
    }

    .jog-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .jog-section {
      background: var(--panel2);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
    }

    .jog-row {
      display: grid;
      grid-template-columns: 54px 1fr 1fr;
      gap: 6px;
      align-items: center;
      margin: 6px 0;
    }

    .jog-label {
      color: var(--muted);
      font-weight: bold;
      text-align: center;
    }

    .direct-inputs {
      display: grid;
      grid-template-columns: repeat(6, minmax(72px, 1fr));
      gap: 6px;
    }

    .direct-inputs label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
      color: var(--muted);
    }

    .wp-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-top: 10px;
    }

    .wp-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 8px 10px;
      border: 1px solid #41485f;
      border-radius: 8px;
      background: var(--panel2);
    }

    .wp-name {
      font-weight: 700;
    }

    .wp-time {
      font-size: 12px;
      color: var(--muted);
      margin-left: 6px;
      font-weight: 400;
    }

    .wp-actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .sequence-box {
      background: var(--panel2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      min-height: 52px;
    }

    .seq-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid #263244;
    }

    .seq-row:last-child {
      border-bottom: none;
    }

    pre {
      background: #0b1120;
      padding: 12px;
      border-radius: 8px;
      overflow: auto;
      max-height: 260px;
      border: 1px solid var(--line);
    }

    @media (max-width: 1200px) {
      .top-grid,
      .two-grid,
      .jog-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .direct-inputs {
        grid-template-columns: repeat(2, 1fr);
      }

      .wp-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <h1>Dual JAKA A12 Control</h1>

  <div class="top-grid">
    <div class="panel">
      <h2>Live Position / Direct Move</h2>

      <div class="two-grid">
        <div>
          <h3>Left Robot</h3>
          <table>
            <tr><th>J1°</th><th>J2°</th><th>J3°</th><th>J4°</th><th>J5°</th><th>J6°</th></tr>
            <tr id="leftJointRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
            <tr><th>X</th><th>Y</th><th>Z</th><th>Rx</th><th>Ry</th><th>Rz</th></tr>
            <tr id="leftTcpRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
          </table>
        </div>

        <div>
          <h3>Right Robot</h3>
          <table>
            <tr><th>J1°</th><th>J2°</th><th>J3°</th><th>J4°</th><th>J5°</th><th>J6°</th></tr>
            <tr id="rightJointRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
            <tr><th>X</th><th>Y</th><th>Z</th><th>Rx</th><th>Ry</th><th>Rz</th></tr>
            <tr id="rightTcpRow"><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
          </table>
        </div>
      </div>

      <h3>Direct Joint Move</h3>
      <div class="small">กรอกค่า Joint เป็นองศา แล้วกด Confirm เพื่อสั่งหุ่นเคลื่อนที่</div>

      <div class="row">
        <label>Target side:
          <select id="directSide">
            <option value="both">Both</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
          </select>
        </label>

        <button onclick="fillJointInputsFromCurrent()">Fill Current</button>
        <button class="orange" onclick="sendDirectJointMove()">Confirm Joint Move</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>

      <div class="two-grid">
        <div>
          <h3>Left Target (deg)</h3>
          <div class="direct-inputs" id="leftJointInputs"></div>
        </div>
        <div>
          <h3>Right Target (deg)</h3>
          <div class="direct-inputs" id="rightJointInputs"></div>
        </div>
      </div>


      <h3>Direct TCP Move</h3>
      <div class="small">
        Safe TCP Move ใช้หลักการ TCP → IK → Joint Move ดังนั้นความเร็วจะอิงจาก Move vel / Move acc ด้านบน ไม่ใช้ linear_move โดยตรง
      </div>

      <div class="row">
        <label>Target side:
          <select id="directTcpSide">
            <option value="both">Both</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
          </select>
        </label>
    <button onclick="fillTcpInputsFromCurrent()">Fill Current TCP</button>
        <button class="orange" onclick="sendDirectTcpMove()">Confirm Safe TCP Move</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>

      <div class="two-grid">
        <div>
          <h3>Left TCP Target</h3>
          <div class="direct-inputs" id="leftTcpInputs"></div>
        </div>
        <div>
          <h3>Right TCP Target</h3>
          <div class="direct-inputs" id="rightTcpInputs"></div>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2>Dual JAKA A12 Manual Jog</h2>

      <div class="row">
        <strong>Robot:</strong>
        <button id="side-left" onclick="setSide('left')">Left</button>
        <button id="side-right" onclick="setSide('right')">Right</button>
        <button id="side-both" onclick="setSide('both')">Both</button>
      </div>

      <div class="row">
        <strong>Mode:</strong>
        <button id="coord-joint" onclick="setCoord('joint')">Joint</button>
        <button id="coord-base" onclick="setCoord('base')">Base TCP</button>
        <button id="coord-tool" onclick="setCoord('tool')">Tool TCP</button>
      </div>

      <div class="row">
        <strong>Both Sync:</strong>
        <select id="syncMode">
          <option value="same">Same</option>
          <option value="mirror">Mirror</option>
          <option value="raw">Raw</option>
        </select>
      </div>

      <div class="row">
        <label>Linear:</label>
        <input id="linearSpeed" type="number" value="5" step="1" min="1" max="50" class="num" />
        <label>Rotate:</label>
        <input id="rotateSpeed" type="number" value="2" step="0.5" min="0.5" max="20" class="num" />
        <label>Joint:</label>
        <input id="jointSpeed" type="number" value="0.03" step="0.01" min="0.005" max="0.2" class="num" />
      </div>

      <div class="row">
        <label>Move vel:</label>
        <input id="moveVel" type="number" value="2.0" step="0.1" min="0.02" max="3.0" class="num" />
        <label>Move acc:</label>
        <input id="moveAcc" type="number" value="1.2" step="0.1" min="0.04" max="3.0" class="num" />
      </div>

      <div class="row">
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
        <button class="green" onclick="homeBoth()">Home Both</button>
        <button onclick="refreshStatus()">Refresh Status</button>
      </div>

      <div class="jog-grid">
        <div class="jog-section">
          <h3>Joint Jog</h3>
          <div id="jointButtons"></div>
        </div>

        <div class="jog-section">
          <h3>TCP Jog 6 Axis</h3>
          <div id="tcpButtons"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Waypoint Manager</h2>

    <div class="row">
      <input id="waypointName" class="wide" placeholder="waypoint name เช่น p1_pre_grasp" />
      <button class="green" onclick="saveWaypoint()">Save Current</button>
      <button onclick="loadWaypoints(true)">Reload List</button>
    </div>

    <div id="waypointList" class="wp-list">Loading...</div>
  </div>

  <div class="two-grid">
    <div class="panel">
      <h2>Program / Sequence</h2>
      <div class="small">กด Add จาก Waypoint Manager เพื่อเรียงลำดับงาน</div>

      <div class="row" style="margin-top: 10px;">
        <label>Program name:</label>
        <input id="programName" type="text" value="demo_pick_place" style="min-width: 180px;" />
        <button onclick="saveProgramFile()">Save File</button>
        <button onclick="refreshProgramList()">Refresh List</button>
        <select id="programSelect" style="min-width: 180px;"></select>
        <button onclick="loadSelectedProgram()">Load File</button>
        <button class="stop" onclick="deleteSelectedProgram()">Delete File</button>
      </div>

      <div id="sequenceList" class="sequence-box"></div>

      <div class="row">
        <button class="green" onclick="runSequence()">Run Program</button>
        <button onclick="saveProgramFile()">Save Program</button>
        <button onclick="loadSelectedProgram()">Load Program</button>
        <button onclick="clearSequence()">Clear Sequence</button>
        <button class="stop" onclick="stopBoth()">STOP BOTH</button>
      </div>
    </div>

    <div class="panel">
      
    <div class="card">
      
  <section class="card">
    <h2>D32.5C Servo Smooth Motion Test</h2>
    <p class="hint">
      Servo mode ใช้ทดสอบ motion แบบ smooth ในอนาคต รอบแรกให้ทดสอบ Tiny Servo กับแขนเดียวก่อน
    </p>

    <div class="row">
      <label>Servo side:</label>
      <select id="servoSide">
        <option value="left" selected>left</option>
        <option value="right">right</option>
        <option value="both">both</option>
      </select>

      <label>Joint:</label>
      <select id="servoJointIndex">
        <option value="0">J1</option>
        <option value="1">J2</option>
        <option value="2">J3</option>
        <option value="3">J4</option>
        <option value="4">J5</option>
        <option value="5" selected>J6</option>
      </select>

      <label>Delta rad:</label>
      <input id="servoDelta" type="number" value="0.0005" step="0.0001" class="num" />

      <label>Repeats:</label>
      <input id="servoRepeats" type="number" value="1" step="1" min="1" max="20" class="num" />
    </div>

    <div class="row">
      <button onclick="enableServoSelected(true)">Enable Servo</button>
      <button onclick="enableServoSelected(false)">Disable Servo</button>
      <button class="orange" onclick="servoTinyTest()">Tiny Servo Test</button>
    </div>
  </section>

<h2>D32 Object Frame / Cooperative Setup</h2>
      <div class="small">
        ขั้นนี้ยังไม่สั่งหุ่นเคลื่อนที่ ใช้สำหรับบันทึก object frame และ grasp offset ของ TCP ซ้าย/ขวา
      </div>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        Safety note: After Home/Jog/Stop/manual reposition, click Sync Current From Live TCP before executing object motion.
      </div>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        D33 Safety: max translation 30 mm, max rotation 0.12 rad per execute. Use Sync Current From Live TCP after Home/Jog/Stop/manual reposition.
      </div>

      <div class="row" style="margin-top: 10px;">
        <label>Object name:</label>
        <input id="objectName" type="text" value="demo_object" style="min-width: 180px;" />
        <button onclick="fillObjectPoseFromMidpoint()">Fill Object From TCP Midpoint</button>
        <button onclick="captureObjectFrameCurrent()">Capture & Save Object Frame</button>
        <button class="orange" onclick="validateObjectTarget()">Validate Target</button>
        <button class="orange" onclick="validateObjectIkJump()">Validate IK Jump</button>
        <button class="orange" onclick="previewObjectTargets()">Preview Cooperative Targets</button>
        <button class="green" onclick="executeObjectMove()">Execute Cooperative Move</button>
        <button onclick="resetObjectPoseToCaptured()">Reset Target To Captured Pose</button>
        <button onclick="resetObjectPoseToCurrent()">Reset Target To Stored Current Pose</button>
        <button class="orange" onclick="syncCurrentObjectPoseFromLive()">Sync Current From Live TCP</button>
        <button onclick="setCurrentObjectPoseFromInputs()">Set Current Object Pose = Inputs</button>
        <button onclick="refreshObjectList()">Refresh Objects</button>
      </div>

      <h3>Object Pose Target / Capture Reference</h3>
      <div class="row">
        <label>Interp steps:</label>
        <input id="objectInterpSteps" type="number" value="10" step="1" min="1" max="100" class="num" />
        <label>Step delay:</label>
        <input id="objectInterpDelay" type="number" value="0.02" step="0.01" min="0" max="2" class="num" />
        <button class="green" onclick="executeObjectInterpolatedMove()">Execute Interpolated Move</button>
      </div>
      <div class="row">
        <label>Servo steps:</label>
        <input id="objectServoSteps" type="number" value="120" step="1" min="10" max="500" class="num" />
        <label>Servo interval:</label>
        <input id="objectServoInterval" type="number" value="0.025" step="0.001" min="0.008" max="0.2" class="num" />
        <button class="green" onclick="executeObjectServoStream()">Execute Servo Smooth Move</button>
      </div>

      <div id="objectPoseInputs" class="targets"></div>

      <div class="row" style="margin-top: 10px;">
        <select id="objectSelect" style="min-width: 220px;"></select>
        <button onclick="loadSelectedObjectFrame()">Load Object</button>
        <button class="stop" onclick="deleteSelectedObjectFrame()">Delete Object</button>
      </div>

      <h3>D35 Object Frame Calibration</h3>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        Move the robot manually/jog to touch the selected physical point, then click Capture. This does not move the robot. Existing Execute still uses legacy frame until D35.6.
      </div>
      <div class="row" style="margin-top: 10px;">
        <label>Object: <input id="d35ObjectName" value="Test2" style="width:120px; margin-right:12px;">
Capture source:</label>
        <select id="calibrationSource">
          <option value="left_tcp">left_tcp</option>
          <option value="right_tcp">right_tcp</option>
          <option value="midpoint">midpoint</option>
        </select>
        <button onclick="captureCalibrationPoint('origin')">Capture Origin</button>
        <button onclick="captureCalibrationPoint('x_axis')">Capture X Axis Point</button>
        <button onclick="captureCalibrationPoint('y_helper')">Capture Y Helper Point</button>
      </div>
      <div class="row">
        <label>Axis length mm:</label>
        <input id="calibrationAxisLength" type="number" value="100" step="10" min="10" max="1000" class="num" />
        <button class="orange" onclick="computeCalibratedObjectFrame()">Compute Calibrated Object Frame</button>
        <button onclick="showCalibrationStatus()">Show Calibration Status</button>
        <button onclick="previewCalibratedAxes()">Preview Calibrated Axes</button>
      </div>
      <pre id="calibrationView" class="statusbox">Calibration not loaded yet.</pre>

      <h3>D35.5A World/Base Calibration</h3>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        Move each robot TCP manually/jog to touch the SAME physical point, then capture left/right for that point. This does not move the robot. Existing Execute still uses legacy frame until D35.6.
      </div>
      <div class="row" style="margin-top: 10px;">
        <button onclick="captureWorldCalibrationPoint('origin', 'left')">Capture Origin Left</button>
        <button onclick="captureWorldCalibrationPoint('origin', 'right')">Capture Origin Right</button>
        <button onclick="captureWorldCalibrationPoint('x_axis', 'left')">Capture X Axis Left</button>
        <button onclick="captureWorldCalibrationPoint('x_axis', 'right')">Capture X Axis Right</button>
        <button onclick="captureWorldCalibrationPoint('y_helper', 'left')">Capture Y Helper Left</button>
        <button onclick="captureWorldCalibrationPoint('y_helper', 'right')">Capture Y Helper Right</button>
      </div>
      <div class="row">
        <button class="orange" onclick="computeWorldCalibrationTransform()">Compute World Transform</button>
        <button onclick="showWorldCalibrationStatus()">Show World Calibration Status</button>
        <button onclick="previewLiveWorldTransform()">Preview Live World Transform</button>
      </div>

      <h3>D35.5B Calibrated Rigid Preview With World Transform</h3>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        Preview only. No motion is sent. Existing Execute still uses legacy frame until D35.6.
      </div>
      <div class="row" style="margin-top: 10px;">
        <label>Object:</label>
        <input id="d355ObjectName" value="Test1" style="width:120px;">
        <label>dx:</label><input id="d355Dx" type="number" value="0" step="1" class="num">
        <label>dy:</label><input id="d355Dy" type="number" value="0" step="1" class="num">
        <label>dz:</label><input id="d355Dz" type="number" value="0" step="1" class="num">
        <label>drx:</label><input id="d355Drx" type="number" value="0" step="0.01" class="num">
        <label>dry:</label><input id="d355Dry" type="number" value="0" step="0.01" class="num">
        <label>drz:</label><input id="d355Drz" type="number" value="0.10" step="0.01" class="num">
      </div>
      <div class="row">
        <button class="orange" onclick="previewCalibratedRigidWithWorldTransform()">Preview Calibrated Rigid With World Transform</button>
      </div>

      <h3>D35.5D IK / Joint Jump Validation</h3>
      <div class="small" style="margin-top: 6px; color: #f59e0b;">
        This validation calls IK only. It does not move the robot. Do not execute calibrated rigid motion until IK validation passes.
      </div>
      <div class="row" style="margin-top: 10px;">
        <label>Object:</label>
        <input id="d355dObjectName" value="Test1" style="width:120px;">
        <label>dx:</label><input id="d355dDx" type="number" value="0" step="1" class="num">
        <label>dy:</label><input id="d355dDy" type="number" value="0" step="1" class="num">
        <label>dz:</label><input id="d355dDz" type="number" value="0" step="1" class="num">
        <label>drx:</label><input id="d355dDrx" type="number" value="0" step="0.01" class="num">
        <label>dry:</label><input id="d355dDry" type="number" value="0" step="0.01" class="num">
        <label>drz:</label><input id="d355dDrz" type="number" value="0.10" step="0.01" class="num">
      </div>
      <div class="row">
        <label>max joint delta rad:</label>
        <input id="d355dMaxJointDelta" type="number" value="0.35" step="0.01" min="0" class="num">
        <label>max sum rad:</label>
        <input id="d355dMaxJointDeltaSum" type="number" value="1.2" step="0.05" min="0" class="num">
        <button class="orange" onclick="validateCalibratedWorldIk()">Validate Calibrated World IK</button>
      </div>

      <h3>D35.6 Calibrated World Rigid Execute</h3>
      <div class="small" style="margin-top: 6px; color: #ef4444; font-weight: 700;">
        WARNING: This can move the real robots. Start with +Z 2 mm only. Keep E-stop ready.
      </div>
      <div class="row" style="margin-top: 10px;">
        <label>Object:</label>
        <input id="d356ObjectName" value="Test1" style="width:120px;">
        <label>dx:</label><input id="d356Dx" type="number" value="0" step="1" class="num">
        <label>dy:</label><input id="d356Dy" type="number" value="0" step="1" class="num">
        <label>dz:</label><input id="d356Dz" type="number" value="2" step="1" class="num">
        <label>drx:</label><input id="d356Drx" type="number" value="0" step="0.005" class="num">
        <label>dry:</label><input id="d356Dry" type="number" value="0" step="0.005" class="num">
