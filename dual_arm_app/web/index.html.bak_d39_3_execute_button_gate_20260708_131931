function findDeepArray(obj, sideName, words) {
  if (!obj || typeof obj !== "object") return null;

  for (const [k, v] of Object.entries(obj)) {
    const key = String(k).toLowerCase();

    if (
      Array.isArray(v) &&
      v.length >= 6 &&
      key.includes(sideName) &&
      words.some(w => key.includes(w))
    ) {
      return v;
    }

    if (v && typeof v === "object") {
      const found = findDeepArray(v, sideName, words);
      if (found) return found;
    }
  }

  return null;
}

function findArrayByCandidates(obj, candidates) {
  if (!obj) return null;

  for (const key of candidates) {
    if (Array.isArray(obj[key]) && obj[key].length >= 6) return obj[key];
  }

  for (const key of candidates) {
    const parts = key.split(".");
    let cur = obj;
    let ok = true;

    for (const p of parts) {
      if (cur && Object.prototype.hasOwnProperty.call(cur, p)) {
        cur = cur[p];
      } else {
        ok = false;
        break;
      }
    }

    if (ok && Array.isArray(cur) && cur.length >= 6) return cur;
  }

  return null;
}

function extractStatusArrays(data) {
  const leftJoint = findArrayByCandidates(data, [
    "left_joint", "left_joints", "left_joint_position", "left_joint_positions",
    "left.joint", "left.joints", "left.joint_position", "left.joint_positions"
  ]) || findDeepArray(data, "left", ["joint"]);

  const rightJoint = findArrayByCandidates(data, [
    "right_joint", "right_joints", "right_joint_position", "right_joint_positions",
    "right.joint", "right.joints", "right.joint_position", "right.joint_positions"
  ]) || findDeepArray(data, "right", ["joint"]);

  const leftTcp = findArrayByCandidates(data, [
    "left_tcp", "left_pose", "left_tcp_pose", "left_cartesian", "left_cart",
    "left.tcp", "left.pose", "left.tcp_pose", "left.cartesian", "left.cart"
  ]) || findDeepArray(data, "left", ["tcp", "pose", "cart"]);

  const rightTcp = findArrayByCandidates(data, [
    "right_tcp", "right_pose", "right_tcp_pose", "right_cartesian", "right_cart",
    "right.tcp", "right.pose", "right.tcp_pose", "right.cartesian", "right.cart"
  ]) || findDeepArray(data, "right", ["tcp", "pose", "cart"]);

  return {leftJoint, rightJoint, leftTcp, rightTcp};
}

