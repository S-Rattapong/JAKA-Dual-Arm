      segmentRotation: 0.026,
      note: "Translation-only tested preset: +Z 50 mm"
    },
    "z-50": {
      delta: [0, 0, -50, 0, 0, 0],
      segmentRotation: 0.026,
      note: "Translation-only tested preset: -Z 50 mm"
    },
    "rx+0.2": {
      delta: [0, 0, 0, 0.2, 0, 0],
      segmentRotation: 0.026,
      note: "Rotation-only tested preset: Rx +0.2 rad"
    },
    "rx-0.2": {
      delta: [0, 0, 0, -0.2, 0, 0],
      segmentRotation: 0.026,
      note: "Rotation-only tested preset: Rx -0.2 rad"
    },
    "ry+0.2": {
      delta: [0, 0, 0, 0, 0.2, 0],
      segmentRotation: 0.026,
      note: "Rotation-only tested preset: Ry +0.2 rad"
    },
    "ry-0.2": {
      delta: [0, 0, 0, 0, -0.2, 0],
      segmentRotation: 0.026,
      note: "Rotation-only tested preset: Ry -0.2 rad"
    },
    "rz+0.3": {
      delta: [0, 0, 0, 0, 0, 0.3],
      segmentRotation: 0.04,
      note: "Rotation-only tested preset: Rz +0.3 rad"
    },
    "rz-0.3": {
      delta: [0, 0, 0, 0, 0, -0.3],
      segmentRotation: 0.04,
      note: "Rotation-only tested preset: Rz -0.3 rad"
    },
    "combo+20+0.1": {
      delta: [0, 0, 20, 0, 0, 0.1],
      segmentRotation: 0.026,
      note: "Combined tested preset: +Z 20 mm and Rz +0.1 rad"
    },
    "combo-20-0.1": {
      delta: [0, 0, -20, 0, 0, -0.1],
      segmentRotation: 0.026,
      note: "Combined tested preset: -Z 20 mm and Rz -0.1 rad"
    },
    "combo+40+0.2": {
      delta: [0, 0, 40, 0, 0, 0.2],
      segmentRotation: 0.026,
      note: "Large combined tested preset: +Z 40 mm and Rz +0.2 rad"
    },
    "combo-40-0.2": {
      delta: [0, 0, -40, 0, 0, -0.2],
      segmentRotation: 0.026,
      note: "Large combined tested preset: -Z 40 mm and Rz -0.2 rad"
    }
  };

  const preset = presets[kind];
  if (!preset) {
    alert("Unknown D35.7 preset: " + kind);
    return;
  }

  const ids = ["d357Dx", "d357Dy", "d357Dz", "d357Drx", "d357Dry", "d357Drz"];
  ids.forEach((id, i) => {
    if ($(id)) $(id).value = String(preset.delta[i]);
  });

  if ($("d357MaxTranslation")) $("d357MaxTranslation").value = "100";
  if ($("d357MaxRotation")) $("d357MaxRotation").value = "0.5";
  if ($("d357MaxSegmentTranslation")) $("d357MaxSegmentTranslation").value = "10";
  if ($("d357MaxSegmentRotation")) $("d357MaxSegmentRotation").value = String(preset.segmentRotation);
  if ($("d357MaxSegmentTcpRotation")) $("d357MaxSegmentTcpRotation").value = "0.12";
  if ($("d357SpeedScale")) $("d357SpeedScale").value = "0.05";
  if ($("d357DryRun")) $("d357DryRun").checked = true;
  if ($("d357Confirm")) $("d357Confirm").value = "";

  lastD357DryRunKey = null;
  lastD357DryRunSummary = null;
  setD357WorkflowState("DRY RUN REQUIRED", "Preset selected: " + kind + ". No motion was sent. Press Dry Run before Execute.", "warn");

  setStatus({
    ok: true,
    mode: "D35.7 preset selected",
    preset: kind,
    target_delta: preset.delta,
    max_segment_translation_mm: 10,
    max_segment_rotation_rad: preset.segmentRotation,
    max_segment_tcp_rotation_rad: 0.12,
    speed_scale: 0.05,
    dry_run: true,
    note: preset.note,
    warning: "Preset selection only. No motion was sent."
  });
}

function roundD357Number(value, digits = 9) {
  const n = Number(value);
  if (!Number.isFinite(n)) return null;
  return Number(n.toFixed(digits));
}

function buildD357DryRunKeyFromPayload(payload) {
  return JSON.stringify({
    name: payload.name,
    target_delta: (payload.target_delta || []).map(v => roundD357Number(v)),
    max_translation_mm: roundD357Number(payload.max_translation_mm),
    max_rotation_rad: roundD357Number(payload.max_rotation_rad),
    max_segment_translation_mm: roundD357Number(payload.max_segment_translation_mm),
    max_segment_rotation_rad: roundD357Number(payload.max_segment_rotation_rad),
    max_segment_tcp_rotation_rad: roundD357Number(payload.max_segment_tcp_rotation_rad),
    max_joint_delta_rad_per_segment: roundD357Number(payload.max_joint_delta_rad_per_segment),
    max_joint_delta_sum_rad_per_segment: roundD357Number(payload.max_joint_delta_sum_rad_per_segment),
    speed_scale: roundD357Number(payload.speed_scale)
  });
}

function describeD357Payload(payload) {
  return {
    name: payload.name,
