function updateLoadedObjectFrame(data, name, options = {}) {
  if (!data || !data.ok) {
    return false;
  }

  const record = data.updated_object_frame || data;
  latestLoadedObjectFrame = record;

  const updateInputs = options.updateInputs !== false;
  if (updateInputs) {
    if (Array.isArray(record.current_object_pose)) {
      setObjectPoseInputs(record.current_object_pose);
    } else if (Array.isArray(record.object_pose)) {
      setObjectPoseInputs(record.object_pose);
    }
  }

  const objectName = record.name || data.name || name;
  if ($("objectName")) $("objectName").value = objectName || "";
  const sel = $("objectSelect");
  if (sel && objectName) {
    const found = Array.from(sel.options).some(opt => opt.value === objectName);
    if (found) sel.value = objectName;
  }

  return true;
}

async function loadObjectByName(name, options = {}) {
  const data = await api("/api/object/load", {
