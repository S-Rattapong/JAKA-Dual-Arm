<!-- D33.3D Real Motion Detection From Status -->
<script>
(function () {
  let prevMotionSnapshot = null;
  let movingHoldUntil = 0;
  let lastBackendActivity = null;

  const MOVING_HOLD_MS = 900;
  const STATUS_POLL_MS = 250;

  function ensureBadge() {
    let b = document.getElementById("robotActivityBadge");
    if (!b) {
      b = document.createElement("div");
      b.id = "robotActivityBadge";
      document.body.appendChild(b);
    }
    b.style.position = "fixed";
    b.style.right = "18px";
    b.style.bottom = "18px";
    b.style.zIndex = "99999";
    b.style.padding = "10px 14px";
    b.style.borderRadius = "12px";
    b.style.fontFamily = "system-ui, sans-serif";
    b.style.fontSize = "14px";
    b.style.fontWeight = "700";
    b.style.color = "white";
    b.style.boxShadow = "0 4px 18px rgba(0,0,0,0.25)";
    return b;
  }

  function setBadge(mode, title, sub) {
    const b = ensureBadge();
    b.className = mode;
    if (mode === "idle") b.style.background = "#166534";
    else if (mode === "running") b.style.background = "#c2410c";
    else if (mode === "moving") b.style.background = "#ca8a04";
    else if (mode === "error") b.style.background = "#991b1b";
    else b.style.background = "#334155";
    b.innerHTML = `${title}<span class="sub" style="display:block;font-size:11px;font-weight:500;opacity:.9;margin-top:2px;">${sub || ""}</span>`;
  }

  function isNumericArray(x) {
    return Array.isArray(x) && x.length >= 3 && x.slice(0, 6).every(v => typeof v === "number" && Number.isFinite(v));
  }

  function collectPoseLikeArrays(obj, path = "", out = {}) {
    if (!obj) return out;

    if (isNumericArray(obj)) {
      const low = path.toLowerCase();
      const useful =
        low.includes("joint") ||
        low.includes("tcp") ||
        low.includes("tool") ||
        low.includes("pose") ||
        low.includes("position") ||
        low.includes("cartesian");

      const side =
        low.includes("left") ||
        low.includes("right");

      if (useful && side) out[path] = obj.slice(0, 6);
    } else if (Array.isArray(obj)) {
      obj.forEach((v, i) => collectPoseLikeArrays(v, `${path}[${i}]`, out));
    } else if (typeof obj === "object") {
      Object.entries(obj).forEach(([k, v]) => {
        const next = path ? `${path}.${k}` : k;
        collectPoseLikeArrays(v, next, out);
      });
    }

    return out;
  }

  function maxAbsDelta(a, b) {
    if (!Array.isArray(a) || !Array.isArray(b)) return 0;
    const n = Math.min(a.length, b.length);
    let m = 0;
    for (let i = 0; i < n; i++) {
      const d = Math.abs(Number(a[i]) - Number(b[i]));
      if (Number.isFinite(d)) m = Math.max(m, d);
    }
    return m;
  }

  function detectMoving(snapshot, prev) {
    if (!snapshot || !prev) return { moving: false, maxDelta: 0, key: null };

    let maxDelta = 0;
    let maxKey = null;
    let moving = false;

    for (const [key, arr] of Object.entries(snapshot)) {
      if (!prev[key]) continue;
      const d = maxAbsDelta(arr, prev[key]);
      const low = key.toLowerCase();

      // TCP/tool/pose are usually mm/rad. Joint may be rad or deg depending on backend.
      const threshold = low.includes("joint") ? 0.0005 : 0.05;

      if (d > maxDelta) {
        maxDelta = d;
        maxKey = key;
      }
      if (d > threshold) moving = true;
    }

    return { moving, maxDelta, key: maxKey };
  }

  async function pollBackendActivity() {
    try {
      const res = await fetch("/api/robot/activity", { cache: "no-store" });
      lastBackendActivity = await res.json();
    } catch (e) {
      lastBackendActivity = { state: "offline", error: "Cannot read backend activity" };
    }
  }

  async function pollRealMotionStatus() {
    try {
      const res = await fetch("/api/status", { cache: "no-store" });
      const status = await res.json();

      const snap = collectPoseLikeArrays(status);
      const det = detectMoving(snap, prevMotionSnapshot);
      prevMotionSnapshot = snap;

      const now = Date.now();
      if (det.moving) {
        movingHoldUntil = now + MOVING_HOLD_MS;
      }

      const backend = lastBackendActivity || {};
      const backendRunning = backend.active || backend.active_commands > 0 || backend.state === "running";
      const backendError = backend.state === "error" || backend.state === "offline";
      const realMoving = now < movingHoldUntil;

      if (backendError) {
        setBadge("error", "🔴 ERROR", backend.last_error || backend.error || "Backend/activity error");
      } else if (realMoving) {
        setBadge("moving", "🟡 MOVING", det.key ? `Live pose changing: ${det.key}` : "Robot still moving");
      } else if (backendRunning) {
        setBadge("running", "🟠 COMMAND", backend.last_path || "Backend command active");
      } else {
        setBadge("idle", "🟢 IDLE", "Live pose stable");
      }
    } catch (e) {
      setBadge("error", "🔴 STATUS ERROR", "Cannot read /api/status");
    }
  }

  setInterval(pollBackendActivity, 500);
  setInterval(pollRealMotionStatus, STATUS_POLL_MS);
  setTimeout(pollBackendActivity, 200);
  setTimeout(pollRealMotionStatus, 400);
})();
</script>


