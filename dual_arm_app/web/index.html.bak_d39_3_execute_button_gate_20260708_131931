    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow: 0 4px 18px rgba(0,0,0,0.25);
  }
  #safetyChecklistPanel .title {
    font-weight: 800;
