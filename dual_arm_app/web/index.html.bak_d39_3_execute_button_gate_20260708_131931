  #safetyChecklistPanel .pass { color: #86efac; }
  #safetyChecklistPanel .fail { color: #fca5a5; }
  #safetyChecklistPanel .warn { color: #fde68a; }
  #safetyChecklistPanel .neutral { color: #cbd5e1; }
  #safetyChecklistPanel .small {
