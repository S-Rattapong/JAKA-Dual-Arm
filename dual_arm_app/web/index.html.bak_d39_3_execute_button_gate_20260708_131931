<div id="demoReadyPanel">
  <div class="demo-title">🎬 Demo Execute Gate</div>
  <div id="demoReadyState" class="demo-state not-ready">⚠️ NOT READY</div>
  <div class="demo-row"><span>1. Motion Limit</span><span id="demoMotionLimit" class="pending">PENDING</span></div>
  <div class="demo-row"><span>2. Freshness</span><span id="demoFreshness" class="pending">PENDING</span></div>
  <div class="demo-row"><span>3. IK Jump</span><span id="demoIkJump" class="pending">PENDING</span></div>
  <div class="small">Recommended flow: Sync → Validate Target → Validate IK Jump → Preview → Execute.</div>
</div>

<script>
(function () {
  const demoSafety = {
    motionLimit: null,
    freshness: null,
    ikJump: null,
    lastBlocked: false,
    lastUpdatedAt: 0
  };

  function el(id) {
    return document.getElementById(id);
  }

  function setItem(id, val) {
    const node = el(id);
    if (!node) return;

    if (val === true) {
      node.textContent = "PASS";
      node.className = "pass";
    } else if (val === false) {
      node.textContent = "FAIL";
      node.className = "fail";
    } else {
      node.textContent = "PENDING";
      node.className = "pending";
    }
  }

  function isReady() {
    return demoSafety.motionLimit === true &&
           demoSafety.freshness === true &&
           demoSafety.ikJump === true;
  }

  function renderDemoReady() {
    setItem("demoMotionLimit", demoSafety.motionLimit);
    setItem("demoFreshness", demoSafety.freshness);
    setItem("demoIkJump", demoSafety.ikJump);

    const state = el("demoReadyState");
    if (!state) return;

    if (demoSafety.lastBlocked) {
      state.textContent = "⛔ BLOCKED";
      state.className = "demo-state blocked";
    } else if (isReady()) {
      state.textContent = "✅ READY TO EXECUTE";
      state.className = "demo-state ready";
    } else {
      state.textContent = "⚠️ NOT READY";
      state.className = "demo-state not-ready";
    }
  }

  function updateDemoSafetyFromResult(data) {
    if (!data || typeof data !== "object") return;

    // Reset blocked flag when a new successful validation/check comes in.
    if (data.ok === true) demoSafety.lastBlocked = false;
    if (data.ok === false) demoSafety.lastBlocked = true;

    const ml = data.motion_limit_check || (
      data.code && String(data.code).includes("object_motion") ? data : null
    );
    if (ml && typeof ml === "object") {
      demoSafety.motionLimit = !!ml.ok;
    }

    const fr = data.freshness_check;
    if (fr && typeof fr === "object") {
      demoSafety.freshness = !!fr.ok;
    }

    const ik = data.ik_joint_jump_check || (
      data.code && String(data.code).includes("ik_joint_jump") ? data : null
    );
    if (ik && typeof ik === "object") {
      demoSafety.ikJump = !!ik.ok;
    }

    // When object is loaded/synced, require fresh validation again.
    if (data.object || data.current_object_pose || data.live_object_pose) {
      if (!data.motion_limit_check && !data.ik_joint_jump_check && !data.freshness_check) {
        demoSafety.motionLimit = null;
        demoSafety.ikJump = null;
        // Sync response itself can imply freshness only if it has live/current pose,
        // but require preview/freshness guard before execute for clarity.
        demoSafety.freshness = null;
        demoSafety.lastBlocked = false;
      }
    }

    demoSafety.lastUpdatedAt = Date.now();
    renderDemoReady();
  }

  function isExecuteEndpoint(url, options) {
    const u = String(url || "");
    const method = String((options && options.method) || "GET").toUpperCase();
    if (method === "GET") return false;
    return (
      u.includes("/api/object/servo_stream") ||
      u.includes("/api/object/execute_move") ||
      u.includes("/api/object/execute_interpolated")
    );
  }

  const prevFetch = window.fetch;
  window.fetch = async function(url, options) {
    if (isExecuteEndpoint(url, options) && !isReady()) {
      const proceed = window.confirm(
        "Safety checklist is NOT READY.\n\n" +
        "Recommended: Sync → Validate Target → Validate IK Jump → Preview first.\n\n" +
        "Continue execute anyway?"
      );
      if (!proceed) {
        return new Response(JSON.stringify({
          ok: false,
          code: "ui_execute_cancelled_not_ready",
          motion_blocked: true,
          error: "User cancelled execute because safety checklist was not ready."
        }), {
          status: 200,
          headers: { "Content-Type": "application/json" }
        });
      }
    }

    const res = await prevFetch.apply(this, arguments);

    try {
      const clone = res.clone();
      clone.json().then(updateDemoSafetyFromResult).catch(() => {});
    } catch (e) {}

    return res;
  };

  window.__demoSafety = demoSafety;
  window.__updateDemoSafetyFromResult = updateDemoSafetyFromResult;
  renderDemoReady();
})();
</script>


