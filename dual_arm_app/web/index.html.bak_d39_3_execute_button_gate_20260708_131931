</style>

<div id="safetyChecklistPanel">
  <div class="title">🛡️ Safety Checklist</div>
  <div class="row"><span class="label">Motion Limit</span><span id="safetyMotionLimit" class="value neutral">-</span></div>
  <div class="row"><span class="label">Freshness</span><span id="safetyFreshness" class="value neutral">-</span></div>
  <div class="row"><span class="label">IK Jump</span><span id="safetyIkJump" class="value neutral">-</span></div>
  <div class="row"><span class="label">Last Result</span><span id="safetyLastResult" class="value neutral">READY</span></div>
  <div id="safetyChecklistNote" class="small">Use Sync → Validate → Preview → Execute.</div>
</div>

<script>
(function () {
  function setText(id, text, cls) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.className = "value " + (cls || "neutral");
  }

  function fmtNum(x, digits) {
    if (typeof x !== "number" || !Number.isFinite(x)) return "-";
    return x.toFixed(digits);
  }

  function updateFromResult(data) {
    if (!data || typeof data !== "object") return;

    const note = document.getElementById("safetyChecklistNote");

    const ml = data.motion_limit_check || (
      data.code && String(data.code).includes("object_motion")
        ? data
        : null
    );

    if (ml && typeof ml === "object") {
      if (ml.ok) {
        setText("safetyMotionLimit", "PASS", "pass");
      } else {
        setText("safetyMotionLimit", "FAIL", "fail");
      }

      if (note && typeof ml.translation_delta_mm === "number") {
        note.textContent =
          `ΔT ${fmtNum(ml.translation_delta_mm, 2)} mm, ` +
          `ΔR ${fmtNum(ml.rotation_delta_rad, 4)} rad`;
      }
    }

    const fr = data.freshness_check;
    if (fr && typeof fr === "object") {
      if (fr.ok) {
        setText("safetyFreshness", "PASS", "pass");
      } else {
        setText("safetyFreshness", "STALE", "fail");
      }
    }

    const ik = data.ik_joint_jump_check || (
      data.code && String(data.code).includes("ik_joint_jump")
        ? data
        : null
    );

    if (ik && typeof ik === "object") {
      if (ik.ok) {
        setText("safetyIkJump", "PASS", "pass");
      } else {
        setText("safetyIkJump", "FAIL", "fail");
      }
    }

    if (data.ok === false) {
      setText("safetyLastResult", "BLOCKED", "fail");
      if (note) note.textContent = data.code || data.error || "Command blocked";
    } else if (data.ok === true && data.message && String(data.message).includes("completed")) {
      setText("safetyLastResult", "EXECUTED", "pass");
    } else if (data.ok === true) {
      setText("safetyLastResult", "READY", "pass");
    }
  }

  const oldFetch = window.fetch;
  window.fetch = async function () {
    const res = await oldFetch.apply(this, arguments);

    try {
      const clone = res.clone();
      clone.json().then(updateFromResult).catch(() => {});
    } catch (e) {}

    return res;
  };

  window.__updateSafetyChecklist = updateFromResult;
})();
</script>


