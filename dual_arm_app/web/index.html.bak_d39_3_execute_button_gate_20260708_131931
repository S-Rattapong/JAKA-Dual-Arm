}

function fmt(v) {
  const n = Number(v);
  if (!Number.isFinite(n)) return "-";
  return n.toFixed(3);
}

function radToDeg(v) {
  return Number(v) * 180.0 / Math.PI;
}

function setStatus(data) {
  const el = $("status");
  if (el) el.textContent = JSON.stringify(data, null, 2);

  try {
    updateD357ResultSummary(data);
  } catch (err) {
    console.warn("D35.7 result summary update failed:", err);
  }
}

function setD357WorkflowState(state, hint, level = "info") {
  const stateEl = $("d357WorkflowState");
  const hintEl = $("d357WorkflowHint");

  const colors = {
    info: "#38bdf8",
    warn: "#f59e0b",
    ok: "#22c55e",
    danger: "#ef4444"
  };

  if (stateEl) {
    stateEl.textContent = state;
    stateEl.style.color = colors[level] || colors.info;
  }

  if (hintEl) {
    hintEl.textContent = hint || "";
  }
}

function d357ShortNumber(v, digits = 4) {
  const n = Number(v);
  if (!Number.isFinite(n)) return "-";
  return n.toFixed(digits);
}

function d357ShortArray(arr, digits = 4) {
  if (!Array.isArray(arr)) return "-";
  return "[" + arr.map(v => d357ShortNumber(v, digits)).join(", ") + "]";
}

function d357ExtractErrors(data) {
  return data?.verify?.errors ||
    data?.commit?.verification?.errors ||
    data?.verification?.errors ||
    data?.last_verification?.errors ||
    data?.pending?.last_verification?.errors ||
    data?.commit?.committed_pending?.last_verification?.errors ||
    null;
}

function d357ExtractTolerances(data) {
  return data?.verify?.tolerances ||
    data?.commit?.verification?.tolerances ||
    data?.verification?.tolerances ||
    data?.last_verification?.tolerances ||
    data?.pending?.last_verification?.tolerances ||
    data?.commit?.committed_pending?.last_verification?.tolerances ||
    null;
}

function d357ExtractPending(data) {
  return data?.verify?.pending ||
    data?.commit?.committed_pending ||
    data?.pending ||
    data?.committed_pending ||
    data?.verification?.pending ||
    null;
}

function d357LooksRelevant(data) {
  if (!data || typeof data !== "object") return false;
  const mode = String(data.mode || "");
  const source = String(data.source || data?.pending?.source || data?.verify?.pending?.source || data?.commit?.committed_pending?.source || "");
  return mode.includes("D35.7") ||
    mode.includes("large_segmented_joint_move") ||
    source.includes("D35.7") ||
    Array.isArray(data.target_delta) ||
    Array.isArray(data?.plan?.target_delta) ||
    Array.isArray(data?.verify?.pending?.target_delta) ||
    Array.isArray(data?.commit?.committed_pending?.target_delta);
}

function updateD357ResultSummary(data) {
  const el = $("d357ResultSummary");
  if (!el || !d357LooksRelevant(data)) return;

  const plan = data?.plan || data;
  const pending = d357ExtractPending(data);
  const errors = d357ExtractErrors(data);
  const tolerances = d357ExtractTolerances(data);

  let state = "D35.7 STATUS";
  let hint = "Review the latest result before continuing.";
  let level = "info";

  if (data?.ok === false || plan?.ok === false) {
    state = "REJECTED / FAILED";
    hint = data.reason || data.error || plan.reason || plan.error || "Request was rejected.";
    level = "danger";
  } else if (data?.mode === "D35.7 preset selected") {
    state = "DRY RUN REQUIRED";
    hint = "Preset selected. Press Dry Run before Execute.";
    level = "warn";
  } else if (data?.dry_run === true && data?.ok === true) {
    state = "DRY RUN PASSED";
    hint = "Execute is unlocked while current values remain unchanged.";
    level = "ok";
  } else if (data?.mode === "D35.7 auto verify + commit complete" || data?.commit?.committed === true) {
    state = "AUTO COMMIT COMPLETE";
    hint = "Motion finished, verified, and object pose was committed.";
    level = "ok";
  } else if (data?.executed === true && data?.ok === true) {
    state = "EXECUTE COMPLETE";
    hint = "Execute finished. Verify and commit pending object pose.";
    level = "ok";
  } else if (data?.ready_to_commit === true || data?.verify?.ready_to_commit === true) {
    state = "READY TO COMMIT";
    hint = "Verification passed. Commit is allowed.";
    level = "ok";
  }

  setD357WorkflowState(state, hint, level);

  const targetDelta = data?.target_delta || plan?.target_delta || pending?.target_delta || null;
  const segmentCount = data?.segment_count || plan?.segment_count || pending?.segment_count || "-";
  const segmentDelta = data?.segment_delta || plan?.segment_delta || null;
  const summary = data?.summary || plan?.summary || null;

  const lines = [];
  lines.push("State: " + state);
  lines.push("Object: " + (data?.name || plan?.name || pending?.name || "-"));
  lines.push("Mode: " + (data?.mode || plan?.mode || pending?.source || "-"));
  lines.push("Target delta: " + d357ShortArray(targetDelta, 4));
  lines.push("Segments: " + segmentCount);
  if (segmentDelta) lines.push("Segment delta: " + d357ShortArray(segmentDelta, 4));

  if (summary) {
    lines.push("");
    lines.push("Joint summary:");
    lines.push("  max left jump:  " + d357ShortNumber(summary.max_left_joint_jump_rad, 6) + " rad");
    lines.push("  max right jump: " + d357ShortNumber(summary.max_right_joint_jump_rad, 6) + " rad");
    lines.push("  left sum:       " + d357ShortNumber(summary.max_left_joint_delta_sum_rad, 6) + " rad");
    lines.push("  right sum:      " + d357ShortNumber(summary.max_right_joint_delta_sum_rad, 6) + " rad");
  }

  if (errors) {
    lines.push("");
    lines.push("Verify errors:");
    lines.push("  left pos:  " + d357ShortNumber(errors.left_position_error_mm, 6) + " mm");
    lines.push("  right pos: " + d357ShortNumber(errors.right_position_error_mm, 6) + " mm");
    lines.push("  left ori:  " + d357ShortNumber(errors.left_orientation_error_rad, 9) + " rad");
    lines.push("  right ori: " + d357ShortNumber(errors.right_orientation_error_rad, 9) + " rad");
  }

  if (tolerances) {
    lines.push("");
    lines.push("Tolerances:");
    lines.push("  position:    " + d357ShortNumber(tolerances.position_tolerance_mm, 3) + " mm");
    lines.push("  orientation: " + d357ShortNumber(tolerances.orientation_tolerance_rad, 4) + " rad");
  }

  if (data?.reason || data?.error || plan?.reason || plan?.error) {
    lines.push("");
    lines.push("Reason: " + (data.reason || data.error || plan.reason || plan.error));
  }

  if (data?.warning) {
    lines.push("");
    lines.push("Warning: " + data.warning);
  }

  el.textContent = lines.join("\\n");
}


async function api(path, options = {}) {
