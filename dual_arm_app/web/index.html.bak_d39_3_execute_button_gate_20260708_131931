    makeObjectPoseInputs();
  }

  return !!$("objectPose0");
}

function angleMean2(a, b) {
  return Math.atan2(Math.sin(a) + Math.sin(b), Math.cos(a) + Math.cos(b));
}

function setObjectPoseInputs(pose) {
  ensureObjectPoseInputs();

  for (let i = 0; i < 6; i++) {
    const el = $("objectPose" + i);
    if (!el) continue;
    el.value = Number(pose[i]).toFixed(i < 3 ? 3 : 6);
  }
}

function collectObjectPoseInputs() {
  ensureObjectPoseInputs();

  const pose = [];

  for (let i = 0; i < 6; i++) {
    const el = $("objectPose" + i);
    if (!el) throw new Error("Object pose input missing: " + i);

    const v = parseFloat(el.value);
    if (!Number.isFinite(v)) {
      throw new Error("Object pose value invalid at index " + i);
    }

    pose.push(v);
  }

  return pose;
}

async function fillObjectPoseFromMidpoint() {
  ensureObjectPoseInputs();

  const data = await api("/api/status");

  const left = data?.left?.tcp;
  const right = data?.right?.tcp;

  if (!Array.isArray(left) || left.length < 6) {
    alert("left TCP missing");
    return;
  }

  if (!Array.isArray(right) || right.length < 6) {
    alert("right TCP missing");
    return;
  }

  const pose = [
    (left[0] + right[0]) / 2.0,
    (left[1] + right[1]) / 2.0,
    (left[2] + right[2]) / 2.0,
    angleMean2(left[3], right[3]),
    angleMean2(left[4], right[4]),
    angleMean2(left[5], right[5]),
  ];

  setObjectPoseInputs(pose);

  $("objectFrameView").textContent =
    "Filled object pose from midpoint of current left/right TCP.\\n" +
    "ยังไม่ได้ save จนกว่าจะกด Capture & Save Object Frame";
}



