async function runD357CalibratedWorldRigidLarge(forceDryRun) {
  const name = getD357ObjectName();
  if (!name) {
    alert("เลือก object หรือกรอก object name ก่อน");
    return;
  }

  const dryRun = forceDryRun ? true : false;
  if ($("d357DryRun")) $("d357DryRun").checked = dryRun;

  const payload = {
    name: name,
    target_delta: collectD357TargetDelta(),
    dry_run: dryRun,
    confirm_execute: $("d357Confirm")?.value || "",
    max_translation_mm: parseFloat($("d357MaxTranslation")?.value || "100.0"),
    max_rotation_rad: parseFloat($("d357MaxRotation")?.value || "0.5"),
    max_segment_translation_mm: parseFloat($("d357MaxSegmentTranslation")?.value || "10.0"),
    max_segment_rotation_rad: parseFloat($("d357MaxSegmentRotation")?.value || "0.026"),
    max_segment_tcp_rotation_rad: parseFloat($("d357MaxSegmentTcpRotation")?.value || "0.12"),
    max_joint_delta_rad_per_segment: 0.12,
    max_joint_delta_sum_rad_per_segment: 0.35,
    speed_scale: parseFloat($("d357SpeedScale")?.value || "0.05"),
    auto_commit: false
  };

  const requestKey = buildD357DryRunKeyFromPayload(payload);

  if (!dryRun) {
    if (!lastD357DryRunKey) {
      alert(
        "ยังไม่มี Dry Run ที่ผ่านสำหรับ D35.7\n\n" +
        "กรุณากด Dry Run D35.7 ก่อน Execute จริง"
      );
      return;
    }

    if (requestKey !== lastD357DryRunKey) {
      alert(
        "ค่า D35.7 ปัจจุบันไม่ตรงกับ Dry Run ล่าสุด\n\n" +
        "กรุณากด Dry Run D35.7 ใหม่ก่อน Execute จริง\n\n" +
        "Dry Run ล่าสุด:\n" + JSON.stringify(lastD357DryRunSummary, null, 2) + "\n\n" +
        "ค่าปัจจุบัน:\n" + JSON.stringify(describeD357Payload(payload), null, 2)
      );
      return;
    }

    const confirmText = $("d357Confirm")?.value || "";
    if (confirmText !== "EXECUTE_LARGE_CALIBRATED_WORLD_RIGID") {
      alert("Dry Run ผ่านแล้ว แต่ยังไม่ได้พิมพ์ EXECUTE_LARGE_CALIBRATED_WORLD_RIGID ใน confirm_execute");
      return;
    }

    const ok = confirm(
      "D35.7 can move the real robots with larger segmented motion.\n\n" +
      "Dry-run gate: PASSED. Current request matches the last successful dry run.\n\n" +
      "Keep E-stop ready. Execute now?"
    );
    if (!ok) return;
  }

  const data = await api("/api/object/execute_calibrated_world_rigid_large", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(payload)
  });

  showCalibrationResult(data);
  updateD357ResultSummary(data);

  if (dryRun) {
    if (data.ok) {
      lastD357DryRunKey = requestKey;
      lastD357DryRunSummary = describeD357Payload(payload);
      if ($("d357Confirm")) {
        $("d357Confirm").value = "EXECUTE_LARGE_CALIBRATED_WORLD_RIGID";
      }
      setStatus({
        ...data,
        dry_run_gate: {
          ready_for_execute: true,
          confirm_auto_filled: true,
          message: "D35.7 dry run passed. confirm_execute was auto-filled. Execute is allowed only while the current values remain unchanged.",
          request: lastD357DryRunSummary
        }
      });
    } else {
      lastD357DryRunKey = null;
      lastD357DryRunSummary = null;
    }
  }

  if (!data.ok) {
    alert("D35.7 request was rejected: " + (data.reason || data.error || "unknown"));
    return;
  }

  if (!dryRun && data.executed) {
    lastD357DryRunKey = null;
    lastD357DryRunSummary = null;
    if ($("d357Confirm")) $("d357Confirm").value = "";

    if ($("d357AutoVerifyCommit")?.checked) {
      await d357AutoVerifyCommitAfterExecute();
    } else {
      setStatus({
        ...data,
        pending_commit_required: true,
        message: "Execute finished. Verify and commit the pending object pose before the next D35.7 dry run or execute."
      });
    }
  }
}


