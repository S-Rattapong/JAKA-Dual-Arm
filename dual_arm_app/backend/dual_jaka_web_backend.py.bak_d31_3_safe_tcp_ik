    "base": 1,
    "tool": 2,
}

AXIS_INDEX = {
    "j1": 0, "joint1": 0, "1": 0,
    "j2": 1, "joint2": 1, "2": 1,
    "j3": 2, "joint3": 2, "3": 2,
    "j4": 3, "joint4": 3, "4": 3,
    "j5": 4, "joint5": 4, "5": 4,
    "j6": 5, "joint6": 5, "6": 5,

    "x": 0,
    "y": 1,
    "z": 2,
    "rx": 3,
    "ry": 4,
    "rz": 5,
}


